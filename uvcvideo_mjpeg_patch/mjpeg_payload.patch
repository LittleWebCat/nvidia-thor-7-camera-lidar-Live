diff -u -x '*.o' -x '*.ko' -x '*.mod*' -x '.*' -x Module.symvers -x modules.order nvidia_r38.2.1_orig/uvc_video.c build/uvc_video.c
--- nvidia_r38.2.1_orig/uvc_video.c	2026-09-25 14:41:21.363136565 -0500
+++ build/uvc_video.c	2026-09-25 14:42:03.955399559 -0500
@@ -258,6 +258,24 @@
 
 		ctrl->dwMaxPayloadTransferSize = bandwidth;
 	}
+
+	/*
+	 * Some cameras (e.g. the 32e4:0234 AR0234 global shutter modules)
+	 * request the largest isochronous packet size for compressed formats
+	 * at every resolution, so only two of them fit on one USB 2.0 bus.
+	 * When the mjpeg_payload parameter is set, cap that request. A frame
+	 * that does not fit the capped bandwidth is dropped, so raise the
+	 * value if the frame rate falls.
+	 */
+	if ((format->flags & UVC_FMT_FLAG_COMPRESSED) &&
+	    uvc_mjpeg_payload_param &&
+	    stream->intf->num_altsetting > 1 &&
+	    ctrl->dwMaxPayloadTransferSize > uvc_mjpeg_payload_param) {
+		uvc_dbg(stream->dev, VIDEO,
+			"Capping compressed payload from %u to %u bytes\n",
+			ctrl->dwMaxPayloadTransferSize, uvc_mjpeg_payload_param);
+		ctrl->dwMaxPayloadTransferSize = uvc_mjpeg_payload_param;
+	}
 }
 
